      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Maximum database size (MB)" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Максимальный размер базы (МБ)" } }
      }
    },
    "chat_history.local_history" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Local chat history" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Локальная история чата" } }
      }
    },
    "chat_history.local_history.footer" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "History is stored only on this device. A value of 0 for retention or database size means unlimited." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "История хранится только на этом устройстве. Значение 0 для срока хранения или размера базы означает отсутствие ограничения." } }
      }
    },
    "chat_history.local_section" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device history" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "История на устройстве" } }
