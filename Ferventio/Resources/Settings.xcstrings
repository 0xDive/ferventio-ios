      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отмена" } }
      }
    },
    "chat.repeat_collapse" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Collapse repeated messages" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сворачивать повторяющиеся сообщения" } }
      }
    },
    "chat.repeat_collapse.footer" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Groups three or more consecutive identical messages sent within 10 seconds into one row with ×N. Broadcaster, moderator, and VIP messages stay separate." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Объединяет три и более одинаковых сообщений подряд, отправленных в течение 10 секунд, в одну строку со счётчиком ×N. Сообщения владельца канала, модераторов и VIP остаются отдельными." } }
      }
    },
    "chat.section" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Chat" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Чат" } }
