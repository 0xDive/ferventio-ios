    "chat_history.recent_messages.footer" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Loads a recent public chat snapshot when opening a channel. Live Twitch chat does not wait for this request." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "При открытии канала загружается недавний публичный снимок чата. Живой чат Twitch не ждёт завершения этого запроса." } }
      }
