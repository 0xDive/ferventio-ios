        "en" : { "stringUnit" : { "state" : "translated", "value" : "Apply 10-minute timeouts" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выдать таймауты на 10 минут" } }
      }
    },
    "nuke.execution.attempted" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Attempted users" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обработано пользователей" } }
      }
    },
