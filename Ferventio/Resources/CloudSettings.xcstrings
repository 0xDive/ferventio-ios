      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected snapshot becomes a new current cloud revision. Its settings are staged locally; tap Done on the Settings screen to apply them." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выбранная копия станет новой текущей облачной ревизией. Её настройки будут подготовлены локально; нажмите «Готово» на экране настроек, чтобы применить их." } }
